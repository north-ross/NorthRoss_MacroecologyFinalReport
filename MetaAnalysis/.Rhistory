prop = predict(m, type="response", newdata = data.frame(x=x.pred))
# Add confidence intervals (optional)
# Get CI from predict function on link function
ci_link = predict(m, newdata = data.frame(x=x.pred), se.fit = TRUE, type="link")
# Use the "invert link" function from the binomial family to convert these to probabilties
linkinv <- family(m)$linkinv
ci_lower = linkinv(ci_link[[1]] - (2*ci_link[[2]]))
ci_upper = linkinv(ci_link[[1]] + (2*ci_link[[2]]))
plot(x, y/n,
xlim=c(0.5,11), ylim=c(0,1), col="red", pch=4,
main="Predicted and measured probability of animal death\n in response to medicine dosage",
ylab="Probability of death", xlab="log(Dosage)")
lines(x.pred, prop)
# 95% CIs
lines(x.pred, ci_lower, lty=2)
lines(x.pred, ci_upper, lty=2)
legend(2015,0.33, c("Mean", "95% CI"), col="black", lty=c(1,2), title="Prediction")
