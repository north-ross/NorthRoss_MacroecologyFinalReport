col = "grey",
ylim=c(-1, max(dat$logmass, na.rm = TRUE)), # set the y axis limits
xlim=c(0, max(dat$abslat, na.rm = TRUE))# set the x axis limits
)
slope <- coef(lm2)["dat$abslat"]
intercept <- coef(lm2)["(Intercept)"]
abline(a = intercept, b = slope) # draws a straight line
pval <- summary(lm2)$coefficients["dat$abslat","Pr(>|t|)"]
# This line specifically "pulls" the p-value for the abslat slope
# from the model summary
# but we will round it to 2 decimal places
pval <- round(pval, digits = 2)
# same with the slope
slope <- round(slope, digits = 2)
text(x = 0, y = 0, # the coordinates within the graph plotting area
labels = paste("Slope =", slope),
pos = 4) # position of the text relative to the coordinates. 4 = to the right
text(x = 0, y = -1, # the coordinates within the graph plotting area
labels = paste("P-value =", pval),
pos = 4)
