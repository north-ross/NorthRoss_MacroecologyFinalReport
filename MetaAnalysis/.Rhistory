Species = c(1,2,3,1,2,3),
# control vs treatment
Group = c("C", "C", "C", "T", "T", "T"),
means = c(640.7, 312.1, 47.0, 113.2,645.1, 47.4),
SE = c(121.4, 49.5, 15.3, 52.1, 99.2, 11.5),
n = c(6,6,6,9,9,9)
)
moss$var = moss$SE^2 * moss$n
