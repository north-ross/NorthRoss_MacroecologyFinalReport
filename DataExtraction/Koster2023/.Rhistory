fg_df <- df %>%
group_by(treat_site, FG, Plot) %>%
summarise(BM = mean(Max_BM), .groups = 'drop') %>%
group_by(treat_site, FG) %>%
summarise(
mean_BM = mean(BM),
n_plots = n(),
sd_BM = sd(BM),
.groups = 'drop'
)
View(fg_df)
# Change and pivot to match extraction table layout
# aggregate FGs
type_dict = list(
"mes" = 'Rich fen',
"oli" = 'Poor fen',
"omb" = 'Bog')
for (i in 1:nrow(fg_df)){
for (j in 1:length(type_dict)){
if (grepl(names(type_dict[j]), fg_df[i,"treat_site"])){
fg_df[i, "Type"] <- type_dict[[j]]
}
}
}
View(fg_df)
# Report biomass by FGs and category
fg_df <- df %>%
group_by(Treatment, Site, FG, Plot) %>%
summarise(BM = mean(Max_BM), .groups = 'drop') %>%
group_by(Treatment, Site, FG) %>%
summarise(
mean_BM = mean(BM),
n_plots = n(),
sd_BM = sd(BM),
.groups = 'drop'
)
for (i in 1:nrow(fg_df)){
for (j in 1:length(type_dict)){
if (grepl(names(type_dict[j]), fg_df[i,"Site"])){
fg_df[i, "Site"] <- type_dict[[j]]
}
}
}
library(tidyr)
# Report biomass by FGs and category
fg_df <- df %>%
group_by(Treatment, Site, FG, Plot) %>%
summarise(BM = mean(Max_BM), .groups = 'drop') %>%
group_by(Treatment, Site, FG) %>%
summarise(
mean_BM = mean(BM),
n_plots = n(),
sd_BM = sd(BM),
.groups = 'drop'
) %>%
# pivot to treatment as columns
pivot_wider(
names_from = Treatment,
values_from = c(mean_BM,n_plots, sd_BM)
)
View(fg_df)
# Change and pivot to match extraction table layout
# aggregate FGs
type_dict = list(
"mes" = 'Rich fen',
"oli" = 'Poor fen',
"omb" = 'Bog')
for (i in 1:nrow(fg_df)){
for (j in 1:length(type_dict)){
if (grepl(names(type_dict[j]), fg_df[i,"Site"])){
fg_df[i, "Site"] <- type_dict[[j]]
}
}
}
orchard_plot(fg1,
mod = "FG_Group",
group = "PaperID",
xlab = "Standardised mean difference (with heteroscedastic population variances)")
library(metafor)
library(orchaRd)
df <- read.csv("ExtractedData_2026-05-15.csv")
# Convert all variances to SD
table(df$Biodiversity_Variance_unit)
df$Control_SD = df$Control_var
df$Treatment_SD = df$Treatment_var
for(i in 1:nrow(df)){
dfi <- df[i,]
if(dfi$Biodiversity_Variance_unit == "SE"){
dfi$Control_SD = dfi$Control_var * sqrt(dfi$Control_n)
dfi$Treatment_SD = dfi$Treatment_var * sqrt(dfi$Treatment_n)
}
df[i,] <- dfi
}
# Note -some of the variances are too high and need to be corrected
# Combine peatland types
df$Peatland_type <- replace(df$Peatland_type,
grepl(" fen", df$Peatland_type),
"Fen")
table(df$Peatland_type)
# Combine functional groups
df$FG_Group <- replace(df$FG_Group,
grepl(" moss", df$FG_Group),
"Moss")
# Convert some variables to factors
df$Peatland_type <- factor(df$Peatland_type)
df$FG_Group <- factor(df$FG_Group)
# Convert to numeric
df$WTD_Difference <- as.numeric(df$WTD_Difference)
# Let's try doing all functional group data then separating them as a variable
fg <- subset(df, df$SR_or_FG=="FG")
# Remove empty
fg <- subset(fg, fg$FG_Group != "")
# Remove "vascular plant" (not really useful for comparison)
fg <- subset(fg, fg$FG_Group != "Vascular plant")
fg$FG_Group <- factor(fg$FG_Group)
# Get effect size
fgES <- escalc(measure = "SMDH", # I think this is best,
# since many of the studies use different units and
# measurement techniques and different sample sizes
m2i = Control_mean,
sd2i = Control_SD,
n2i = Control_n,
m1i = Treatment_mean,
sd1i = Treatment_SD,
n1i = Treatment_n,
data = fg)
# Try a one-variable with FG
fg1 <-rma.mv(
yi=yi,
V=vi,
mods=~FG_Group,
random= ~1|PaperID/ID,
method="REML",
digits=4,
data=fgES)
summary(fg1)
# only significant change is in trees (shrubs are significant only at p=0.1)
# makes sense, trees should increase strongly with WT drawdown
orchard_plot(fg1,
mod = "FG_Group",
group = "PaperID",
xlab = "Standardised mean difference (with heteroscedastic population variances)")
# I think this looks pretty good?
orchard_plot(fg1,
mod = "FG_Group",
group = "PaperID",
xlab = "Standardised mean difference (with heteroscedastic population variances)")
df <- read.csv("Koster_2023_data_2021_Vascular_plant_biomass.csv")
View(df)
summary(fg1)
