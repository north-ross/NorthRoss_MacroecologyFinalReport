dat <- read.csv(file = "murphy_data_cleaned.csv")
head(dat)
table(dat$Disturbance_category)
# Fix spelling errors with dictionary style replace
dict = list(
"Habitat disturbance" = 'Habitat Disturbance',
"Land-use change" = 'Land use change',
"Nutrient addition" = 'Nutrient Addition',
"Species invasion" = "Invasive species",
"Temp. Increase" = "Temperature increase")
dc = dat$Disturbance_category
for (i in 1:length(dict)){dc <- replace(dc, dc == names(dict[i]), dict[[i]])}
dat$Disturbance_category <- dc
table(dat$Disturbance_category)
luc <- subset(dat, dat$Disturbance_category == "Land use change")
# Fix more spelling
table(luc$Species_category)
luc$Species_category <- replace(luc$Species_category,
luc$Species_category == "Endothern",
"Endotherm")
# factorize
luc$Species_category <- factor(luc$Species_category)
table(luc$Biome)
# combine northern and southern temperate forest since there's only 1 southrn
# Possibly we should exclude Mediterranean since there is only 1
dict = list(
"Northern Temperate Forest" = 'Temperate Forest',
"Southern Temperate Forest" = 'Temperate Forest')
for (i in 1:length(dict)){luc$Biome <- replace(luc$Biome, luc$Biome == names(dict[i]), dict[[i]])}
table(luc$Disturbance_Type)
# Combine "agricultural" type ones
luc$Disturbance_Type <- replace(luc$Disturbance_Type,
grepl("Agricul", luc$Disturbance_Type),
"Agriculture")
# numbers all look good, except Latitude
# Exp_or_Obs has only Observational, no experiments in this subset, so we can ignore this
library(metafor)
datES <- escalc(measure = "SMD", #
m2i = Control_Mean, # group 2 corresponds to the control group
sd2i = Control_SD,
n2i = Control_n,
m1i = Treatment_Mean, # group 1 is the treatment group
sd1i = Treatment_SD,
n1i = Treatment_n,
data = luc)
funnel(x = datES$yi,
vi = datES$vi)
summary(grandmean1)
grandmean1 <-rma.mv(
yi=yi,
V=vi,
random= ~1|PaperID/ID,
method="REML",
digits=4,
data=datES)
datES$ID <- 1:nrow(datES)
grandmean1 <-rma.mv(
yi=yi,
V=vi,
random= ~1|PaperID/ID,
method="REML",
digits=4,
data=datES)
summary(grandmean1)
disturb1 <-rma.mv(
yi=yi,
V=vi,
mods=~Disturbance_Type,
random= ~1|PaperID/ID,
method="REML",
digits=4,
data=datES)
summary(disturb1)
table(luc$Disturbance_Type)
# Add "human development" to urbbanization
luc$Disturbance_Type <- replace(luc$Disturbance_Type,
"Human development",
"Urbanization")
# Add "human development" to urbbanization
luc$Disturbance_Type <- replace(luc$Disturbance_Type,
luc$Disturbance_Type == "Human development",
"Urbanization")
datES <- escalc(measure = "SMD", #
m2i = Control_Mean, # group 2 corresponds to the control group
sd2i = Control_SD,
n2i = Control_n,
m1i = Treatment_Mean, # group 1 is the treatment group
sd1i = Treatment_SD,
n1i = Treatment_n,
data = luc)
funnel(x = datES$yi,
vi = datES$vi)
paper = table(luc$PaperID)
paper[paper>1]
datES$ID <- 1:nrow(datES)
disturb1 <-rma.mv(
yi=yi,
V=vi,
mods=~Disturbance_Type,
random= ~1|PaperID/ID,
method="REML",
digits=4,
data=datES)
summary(disturb1)
disturb_species_add <-rma.mv(
yi=yi,
V=vi,
mods=~Disturbance_Type + Species_category,
random= ~1|PaperID/ID,
method="REML",
digits=4,
data=datES)
summary(disturb_species_add)
